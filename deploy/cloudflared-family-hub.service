[Unit]
Description=Cloudflare Tunnel for Family Hub
After=network-online.target family-hub.service
Wants=network-online.target

[Service]
Type=simple
User=cloudflared
Group=cloudflared
# Place tunnel credentials from `cloudflared tunnel create` / Zero Trust UI:
#   /etc/cloudflared/family-hub.json
# And config (hostname → http://127.0.0.1:3020) at:
#   /etc/cloudflared/config.yml
ExecStart=/usr/bin/cloudflared tunnel --config /etc/cloudflared/config.yml run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
