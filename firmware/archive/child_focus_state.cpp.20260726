#include "child_focus_state.h"

static bool childIsoDateValid(const char* value) {
  if (!value || strlen(value) != 10 || value[4] != '-' || value[7] != '-') return false;
  for (int i = 0; i < 10; ++i) {
    if (i == 4 || i == 7) continue;
    if (value[i] < '0' || value[i] > '9') return false;
  }
  return true;
}

const JsonDocument& displayHomeFilter() {
  static JsonDocument filter;
  static bool ready = false;
  if (!ready) {
    filter["sync"]["contractVersion"] = true;
    filter["sync"]["contractRevision"] = true;
    filter["sync"]["staleAfterSeconds"] = true;
    filter["mode"]["childModeAvailable"] = true;
    filter["mode"]["childModeEntryVisible"] = true;
    filter["mode"]["entryChildId"] = true;
    filter["mode"]["enterDirectlyWhenSingle"] = true;
    filter["mode"]["profileSwitchingEnabled"] = true;
    filter["mode"]["launchTarget"] = true;
    filter["mode"]["refreshSeconds"] = true;
    filter["mode"]["idleReturnSeconds"] = true;
    filter["mode"]["returnToHomeWhenIdle"] = true;
    filter["mode"]["exitChallengeRequired"] = true;
    filter["mode"]["childSwitchChallengeRequired"] = true;
    filter["children"][0]["id"] = true;
    filter["children"][0]["displayName"] = true;
    filter["children"][0]["displayColor"] = true;
    filter["children"][0]["avatarEmoji"] = true;
    filter["children"][0]["profileMediaRef"] = true;
    filter.shrinkToFit();
    ready = true;
  }
  return filter;
}

