    filter["taskActions"]["canRequestTask"] = true;
    filter["rewards"][0]["id"] = true;
    filter["rewards"][0]["name"] = true;
    filter["rewards"][0]["rewardType"] = true;
    filter["rewards"][0]["mediaRef"] = true;
    filter["rewards"][0]["cost"] = true;
    filter["rewards"][0]["selectionAllowed"] = true;
    filter["rewards"][0]["goal"]["id"] = true;
    filter["rewards"][0]["goal"]["status"] = true;
    filter["rewards"][0]["goal"]["ready"] = true;
    filter["rewardActions"]["canSelectReward"] = true;
    filter["rewardActions"]["canRequestReward"] = true;
    filter["daily"] = true;
    filter["term"] = true;
    filter["activeCorrection"] = true;
    filter["skillGoals"][0]["id"] = true;
    filter["skillGoals"][0]["title"] = true;
    filter["skillGoals"][0]["icon"] = true;
    filter["skillGoals"][0]["mediaRef"] = true;
    filter["skillGoals"][0]["progress"] = true;
    filter["skillGoals"][0]["target"] = true;
    filter["skillGoals"][0]["state"] = true;
    filter["skillGoals"][0]["recentDecision"] = true;
    filter["skillGoals"][0]["allowedAction"] = true;
    filter["todayPositiveProgress"] = true;
    filter["todaySkillProgress"] = true;
    filter["recentSkillCelebration"]["id"] = true;
    filter["recentSkillCelebration"]["goalId"] = true;
