  }
  return filter;
}

bool displayHomeValid(const JsonDocument& state) {
  if (!state.is<JsonObjectConst>()) return false;
  return state["sync"]["contractVersion"].as<int>() == 1 &&
         state["children"].is<JsonArrayConst>() && state["mode"].is<JsonObjectConst>();
}

bool childModeValid(const JsonDocument& state, const String& expectedChildId) {
  if (!state.is<JsonObjectConst>()) return false;
  const char* id = state["child"]["id"] | "";
  const char* taskDate = state["taskDate"] | "";
  const int revision = state["sync"]["contractRevision"].as<int>();
  JsonVariantConst goals = state["skillGoals"];
  if (!goals.isNull() && (!goals.is<JsonArrayConst>() || goals.as<JsonArrayConst>().size() > 3)) {
    return false;
  }
  if (revision >= 3 && !goals.is<JsonArrayConst>()) return false;
  JsonVariantConst actions = state["allowedChildActions"];
  if (!actions.isNull() && (!actions.is<JsonArrayConst>() || actions.as<JsonArrayConst>().size() > 4)) {
    return false;
  }
  return state["sync"]["contractVersion"].as<int>() == 1 && revision >= 2 &&
         childIsoDateValid(taskDate) &&
         state["mode"].as<String>() == "child_focus" && expectedChildId == id &&
         state["focus"].is<JsonObjectConst>();
}

const char* childFocusPageName(ChildFocusPage page) {
  switch (page) {
    case ChildFocusPage::Selection: return "selection";
    case ChildFocusPage::Dashboard: return "dashboard";
    case ChildFocusPage::Task: return "task";
    case ChildFocusPage::Waiting: return "waiting";
    case ChildFocusPage::Celebrate: return "celebrate";
    case ChildFocusPage::Treats: return "treats";
    case ChildFocusPage::Reward: return "reward";
    case ChildFocusPage::Goals: return "goals";
    case ChildFocusPage::Skill: return "skill";
    case ChildFocusPage::Correction: return "correction";
    case ChildFocusPage::FirstThen: return "first_then";
    case ChildFocusPage::Pin: return "pin";
  }
  return "selection";
}
