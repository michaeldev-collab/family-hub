# Family Hub server configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3020
DB_PATH=./data/family-hub.sqlite
# Optional LAN write token (leave empty for trust-on-LAN mode)
# Browser: API.setWriteToken('...') in devtools, or localStorage familyHubWriteToken
# Panel: NVS key write_tok, or build flag -DFAMILY_HUB_WRITE_TOKEN=\"...\"
WRITE_TOKEN=
# Scoped panel token: authorizes ONLY chore completion / grocery toggle
# (POST /api/chores/:id/complete, POST /api/grocery/:id/toggle), not the
# general write surface. Give the ESP32 panel this token instead of WRITE_TOKEN.
# Leave empty to inherit LAN-trust mode when Clerk is off.
PANEL_TOKEN=

# Cloudflare Tunnel: set TRUST_PROXY=true so Express sees client IP / HTTPS.
# PUBLIC_APP_URL=https://family.example.com
TRUST_PROXY=
PUBLIC_APP_URL=
# REJECT_PANEL_VIA_TUNNEL=true (default) — deny PANEL_TOKEN when CF-Ray is present
REJECT_PANEL_VIA_TUNNEL=true

# Clerk (browser humans). Leave CLERK_SECRET_KEY empty to disable Clerk and
# keep LAN trust / WRITE_TOKEN behavior for local-only installs.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated origins allowed in JWT azp (tunnel + localhost)
# CLERK_AUTHORIZED_PARTIES=https://family.example.com,http://127.0.0.1:3020
CLERK_AUTHORIZED_PARTIES=
# Optional allowlist of Clerk user ids (comma-separated). Empty = any signed-in user.
CLERK_ALLOWED_USER_IDS=
# NODE_ENV=test only — ignored in development; throws if set in production
CLERK_TEST_BYPASS=false

# Write rate limit (panel GETs are not limited)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_WRITES=180

# Reminders delivery (v1.1 — prep only in v1.0.x)
N8N_REMINDER_WEBHOOK_URL=
REMINDERS_ENABLED=false
